# Server
NODE_ENV=development
PORT=3001

# Database
MONGODB_URI=mongodb://localhost:27017/promanage_hub

# Auth
JWT_SECRET=replace_me_with_a_long_random_string_at_least_16_chars
# If omitted, JWT_REFRESH_SECRET defaults to JWT_SECRET (env loader).
JWT_REFRESH_SECRET=replace_me_with_another_long_random_string
# JWT expiry strings (jsonwebtoken "expiresIn"): examples "15m", "1h", "7d"
TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d

# CORS
# Example:
# CORS_ORIGIN=http://localhost:3000
CORS_ORIGIN=
